# Keep real keys in .env; never commit them.
RAG_MODE=mock
MOCK_ADMIN_PASSWORD=
RUN_REAL_INTEGRATION=0
RUN_POSTGRES_INTEGRATION=0
RUN_REAL_EVAL=0
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://rag:change-me@127.0.0.1:5432/rag
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Optional Eval rates per million tokens. Leave blank when pricing is unknown.
DEEPSEEK_INPUT_COST_PER_MILLION=
DEEPSEEK_OUTPUT_COST_PER_MILLION=
DEEPSEEK_COST_CURRENCY=CNY
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_DIMENSION=1024
RERANK_MODEL=qwen3-rerank
MIN_SIMILARITY_SCORE=
JWT_SECRET=
JWT_ISSUER=rag-agent-local
JWT_AUDIENCE=rag-agent-api
JWT_EXPIRE_MINUTES=30
